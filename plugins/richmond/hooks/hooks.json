{
  "modules": ["./register.tsx"],
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sound.sh turn-done", "timeout": 5, "async": true }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sound.sh needs-you", "timeout": 5, "async": true }]
      }
    ],
    "Elicitation": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sound.sh needs-you", "timeout": 5, "async": true }] }
    ]
  }
}
